# Copy to .env and edit. Used by `npm run dev` (tsx --env-file=.env).

# Folder of audio files to scan (MP3/FLAC/M4A/OGG/OPUS/WAV).
MUSIC_DIR=/path/to/your/Music

# Where the SQLite DB and cover/artist-image cache are written.
DATA_DIR=./data

# Session cookie signing key.
# Leave unset and Localhost Music generates a secret on first run and stores it in
# DATA_DIR/.jwt-secret. To manage the secret yourself:
#     JWT_SECRET=$(openssl rand -hex 32)
# Never use a value that appears in a public repo (Localhost Music refuses to boot on the known
# placeholders): anyone could sign themselves an admin session on your server.
# JWT_SECRET=

# Bootstrap admin account, created on first run. If ADMIN_PASSWORD is unset, Localhost Music
# generates a random password and prints it to the log once.
ADMIN_USER=admin
# ADMIN_PASSWORD=

# Set to 1 when Localhost Music sits behind a reverse proxy (Caddy/nginx/Traefik/Cloudflare), so
# it trusts X-Forwarded-For/-Proto: the login throttle then sees the real client IP, and
# the session cookie gets the Secure flag on https. Leave unset if exposed directly,
# otherwise a client could spoof those headers.
# TRUST_PROXY=1

# Force the session cookie's Secure flag on (1) or off (0). Default: follow the request
# scheme. You shouldn't need this.
# COOKIE_SECURE=

# HTTP port (optional, defaults to 8585; `npm run dev` uses 3000).
# PORT=8585

# Optional: free key from https://fanart.tv/get-an-api-key/ for wide artist
# banners. Without it, Localhost Music falls back to Deezer artist photos.
# FANART_API_KEY=
