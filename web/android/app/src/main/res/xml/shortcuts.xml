<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon -> "Change server". -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="change_server"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/change_server"
        android:shortcutLongLabel="@string/change_server">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.localhostmusic"
            android:targetClass="io.github.localhostmusic.ServerSetupActivity" />
    </shortcut>
</shortcuts>
